# ── Patogh — Production Environment Variables ──────────────────────────────────
#
# Instructions:
#   cp .env.production.example .env.production
#   nano .env.production          # fill in all values
#   chmod 600 .env.production     # restrict read access
#
# NEVER commit .env.production to version control.

# ── Domain ───────────────────────────────────────────────────────────────────────
# Your server's domain (without https:// or trailing slash)
DOMAIN=patogh.example.com

# ── Database ─────────────────────────────────────────────────────────────────────
# Strong random password — generate with:
#   openssl rand -base64 32
POSTGRES_PASSWORD=change_me_strong_postgres_password

# ── Redis ────────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=change_me_strong_redis_password

# ── JWT ──────────────────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters (64+ recommended).
# Generate with: openssl rand -base64 64
JWT_SECRET=change_me_generate_with_openssl_rand_base64_64

# ── HTTP port ────────────────────────────────────────────────────────────────────
# Port that Nginx listens on (default 80).
# If using an external SSL terminator (Cloudflare, Traefik, certbot+nginx-host),
# leave this as 80 and configure SSL at the host level.
HTTP_PORT=80
